{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "jquery": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "bootstrap": "readonly",
    "htmx": "readonly"
  },
  "plugins": [
    "security"
  ],
  "rules": {
    "no-undef": "warn",
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": [
        "apps/autocomplete/static/autocomplete/js/autocomplete.js"
      ],
      "rules": {
        "@typescript-eslint/no-unused-vars": "off",
        "no-unused-vars": "off",
        "security/detect-object-injection": "off"
      }
    }
  ]
}
